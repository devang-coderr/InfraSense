# =============================================================================
# InfraSense Root .gitignore
# =============================================================================

# --- Environment & Secret Files (NEVER COMMIT REAL SECRETS) ---
.env
.env.local
.env.*.local
.env.production
.env.development
*.env

# Allow example template files
!.env.example
!.env.local.example

# --- Python & Virtual Environments ---
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
ENV/
.pytest_cache/
*.egg-info/
.coverage
htmlcov/

# --- Databases ---
*.db
*.sqlite
*.sqlite3
infrasense.db

# --- Node & Next.js Build Output ---
node_modules/
frontend/node_modules/
.next/
frontend/.next/
out/
frontend/out/
build/
frontend/build/
*.tsbuildinfo
next-env.d.ts
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.vercel/

# --- Media Storage & Generated Test Run Artifacts ---
backend/media/*
!backend/media/.gitkeep
backend/runs/
backend/bus.jpg
*.pt
*.onnx
*.weights
*.safetensors
*.h5

# --- OS & Editor Specific Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
