# =============================================================================
# InfraSense Root Environment Configuration Template (.env.example)
# =============================================================================
# Copy this file to ".env" in backend/ and ".env.local" in frontend/ as needed.
# DO NOT commit files containing actual secrets or passwords to Git.
# =============================================================================

# --- Backend Configuration (backend/.env) ---
# Database (defaults to local SQLite file for zero setup)
DATABASE_URL=sqlite:///./infrasense.db

# Authentication / JWT
SECRET_KEY=your-random-secret-key-here
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Allowed Origins
CORS_ORIGINS=http://localhost:3000

# File Storage Provider ("local" or "supabase")
STORAGE_PROVIDER=local
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=infrasense-media

# Optional AI / Weather Integration Placeholders
AI_MODEL_PATH=
WEATHER_API_KEY=

# --- Frontend Configuration (frontend/.env.local) ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
