# =============================================================================
# InfraSense backend — environment variables
# =============================================================================
# Copy this file to ".env" (same folder) and fill in the values.
# ".env" is in .gitignore and must NEVER be committed to Git.
# Every variable below is explained in backend/README.md section "Environment
# variables" — what it is, where to get it, whether it's secret.
# =============================================================================

# --- Database ---------------------------------------------------------------
# REQUIRED NOW. Default: local SQLite file, works instantly, zero setup.
# To use Postgres/Supabase later, replace with something like:
#   postgresql+psycopg://postgres:YOURPASSWORD@db.xxxx.supabase.co:5432/postgres
DATABASE_URL=sqlite:///./infrasense.db

# --- Auth / JWT --------------------------------------------------------------
# REQUIRED NOW. Secret. You generate this yourself (see README) — it is NOT
# an API key from any website. It is used to sign login tokens.
SECRET_KEY=change-this-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- CORS ---------------------------------------------------------------------
# REQUIRED NOW. Comma-separated list of frontend origins allowed to call this API.
CORS_ORIGINS=http://localhost:3000

# --- File storage --------------------------------------------------------------
# REQUIRED NOW (default "local" — saves files to backend/media, no account needed).
# Set to "supabase" later if you want cloud storage. See README "Storage setup".
STORAGE_PROVIDER=local

# Only needed if STORAGE_PROVIDER=supabase. FUTURE / OPTIONAL for now.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=infrasense-media

# --- AI (future) ---------------------------------------------------------------
# OPTIONAL / FUTURE. Leave blank. The app runs a rule-based "baseline AI"
# with no external key needed. Fill this in only when you plug in a real model.
AI_MODEL_PATH=
WEATHER_API_KEY=
